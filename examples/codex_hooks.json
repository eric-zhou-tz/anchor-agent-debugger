{
  "description": "Send raw Codex hook payloads to Anchor ingestion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc '/path/to/Anchor/bin/anchor ingest --source codex >>/tmp/anchor-codex-hooks.log 2>>/tmp/anchor-codex-hooks.err'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc '/path/to/Anchor/bin/anchor ingest --source codex >>/tmp/anchor-codex-hooks.log 2>>/tmp/anchor-codex-hooks.err'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc '/path/to/Anchor/bin/anchor ingest --source codex >>/tmp/anchor-codex-hooks.log 2>>/tmp/anchor-codex-hooks.err'",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc '/path/to/Anchor/bin/anchor ingest --source codex >>/tmp/anchor-codex-hooks.log 2>>/tmp/anchor-codex-hooks.err'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc '/path/to/Anchor/bin/anchor ingest --source codex >>/tmp/anchor-codex-hooks.log 2>>/tmp/anchor-codex-hooks.err'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc '/path/to/Anchor/bin/anchor ingest --source codex >>/tmp/anchor-codex-hooks.log 2>>/tmp/anchor-codex-hooks.err'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
